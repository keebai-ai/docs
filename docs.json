{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "KeebAI",
  "colors": {
    "primary": "#FF73C2",
    "light": "#FF73C2",
    "dark": "#FF73C2"
  },
  "appearance": {
    "default": "light"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@keebai.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Keebai",
      "href": "https://app.keebai.com"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "dev/overview",
              "dev/quickstart"
            ]
          },
          {
            "group": "Authentication",
            "pages": [
              "dev/api-keys",
              "dev/authentication",
              "dev/scopes"
            ]
          },
          {
            "group": "SDK",
            "pages": [
              "dev/sdks/typescript"
            ]
          },
          {
            "group": "CLI",
            "pages": [
              "dev/sdks/cli"
            ]
          },
          {
            "group": "Agent Skills",
            "pages": [
              "dev/sdks/agent-skills"
            ]
          },
          {
            "group": "Limits",
            "pages": [
              "dev/rate-limits"
            ]
          }
        ]
      },
      {
